/**
 * @file pca9685_version.h
 * @brief PCA9685 driver version, generated by CMake from pca9685_version.h.in.
 * @copyright Copyright (c) 2026 The driver-pca9685 authors. SPDX-License-Identifier: MIT
 *
 * Do not edit the generated file: the version is set once, in cmake/pca9685_build_settings.cmake, and
 * configure_file() writes it here.
 */
#ifndef PCA9685_VERSION_H
#define PCA9685_VERSION_H

/** Major version: incompatible API changes. */
#define PCA9685_VERSION_MAJOR @PCA9685_VERSION_MAJOR@
/** Minor version: features added compatibly. */
#define PCA9685_VERSION_MINOR @PCA9685_VERSION_MINOR@
/** Patch version: fixes. */
#define PCA9685_VERSION_PATCH @PCA9685_VERSION_PATCH@
/** Full version string, for example "0.1.0". */
#define PCA9685_VERSION_STRING "@PCA9685_VERSION@"

#endif // PCA9685_VERSION_H
